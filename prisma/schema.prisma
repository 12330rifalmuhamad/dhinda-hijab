generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  imageUrl  String? // Banner image for the category
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Int
  originalPrice Int? // Harga asli/coret
  label         String? // Custom label (e.g. Best Seller, New Arrival)
  stock         Int            @default(0)
  isBestSeller  Boolean        @default(false)
  shopeeUrl     String? // Link to Shopee product
  tiktokUrl     String? // Link to TikTok Shop product
  material      String? // Product material (e.g. Katun Bordir)
  videoUrl      String? // URL to product video (e.g. cloudinary)
  sizeChart     String? // URL to size chart image
  images        ProductImage[]
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id        String        @id @default(cuid())
  name      String?
  email     String        @unique
  password  String
  phone     String?
  gender    String?
  birthDate DateTime?
  role      UserRole      @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  orders        Order[]
  vouchers      UserVoucher[]
  addresses     Address[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  // Payment Details
  subtotal        Int     @default(0)
  shippingCost    Int     @default(0)
  discount        Int     @default(0)
  totalAmount     Int
  paymentType     String?
  paymentStatus   String  @default("pending")
  snapToken       String?
  snapRedirectUrl String?
  voucherCode     String?

  // Shipping Details
  shippingAddress String? @db.Text
  shippingAreaId  String?
  courier         String?
  shippingService String?
  trackingNumber  String?
  biteshipOrderId String?
  waybillUrl      String?
  recipientName   String?
  recipientPhone  String?
  notes           String? @db.Text

  status    OrderStatus @default(PENDING)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model HeroSlide {
  id            String   @id @default(cuid())
  image         String
  mobileImage   String?
  leftTitle     String
  leftSubtitle  String
  rightTitle    String
  rightSubtitle String
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomeSection {
  id              String   @id @default(cuid())
  type            String // 'HERO', 'PRODUCT_SLIDER', 'CATEGORY_GRID', 'OFFLINE_STORE', 'BANNER'
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  title           String?
  subtitle        String?
  content         Json?
  backgroundColor String?
  backgroundImage String?
  gradientStart   String?
  gradientEnd     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @db.Text
  content   String   @db.Text
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PopupBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id           String        @id @default(cuid())
  code         String        @unique
  discount     Int // Percentage (e.g. 10) or Flat Amount
  type         String // 'PERCENTAGE' or 'FLAT'
  minPurchase  Int           @default(0)
  maxDiscount  Int? // Max discount amount for percentage type
  stock        Int           @default(100)
  startDate    DateTime      @default(now())
  endDate      DateTime
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userVouchers UserVoucher[]
}

model UserVoucher {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  voucherId String
  voucher   Voucher   @relation(fields: [voucherId], references: [id])
  isUsed    Boolean   @default(false)
  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  @@unique([userId, voucherId]) // User can only claim a voucher once
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  fullAddress   String   @db.Text
  province      String?
  city          String?
  district      String?
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
